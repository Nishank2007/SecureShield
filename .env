# .env — copy this file to .env and fill in your values
# Never commit the real .env to git

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/w3schools_db
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/w3schools_db
MONGO_URI=mongodb://127.0.0.1:27017/w3schools_db

# JWT signing secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Port for the Express server
PORT=5000

# Default administrator credentials
# Set these in your .env file instead of exposing them publicly.
# ADMIN_USERNAME=CyberSprint
# ADMIN_PASSWORD=Anshika1908

# Frontend origin (used for CORS in production)
CLIENT_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
