# .env — copy this file to .env and fill in your values
# Never commit the real .env to git

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/w3schools_db
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/w3schools_db
MONGO_URI=mongodb://127.0.0.1:27017/w3schools_db

# JWT signing secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Port for the Express server
PORT=5000

# Frontend origin (used for CORS in production)
CLIENT_URL=http://localhost:3000

# ── Email (Nodemailer) — OTP is sent to the user’s email on signup / resend ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-specific-password
# MAIL_FROM="W3Schools Clone <your@gmail.com>"
# Optional subject override:
# MAIL_OTP_SUBJECT=Your verification code

# ── SMS (Fast2SMS) — Indian mobile OTP ──
# FAST2SMS_API_KEY=
